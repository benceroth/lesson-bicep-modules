{
  "analyzers": {
    "core": {
      "enabled": true,
      "rules": {
        "no-hardcoded-location": {
          "level": "off"
        },
        "use-recent-api-versions": {
          "level": "off"
        },
        "no-unused-params": {
          "level": "warning"
        },
        "no-unused-vars": {
          "level": "warning"
        },
        "outputs-should-not-contain-secrets": {
          "level": "error"
        },
        "secure-secrets-in-params": {
          "level": "error"
        }
      }
    }
  }
}
